rules_version = '2';

// ══════════════════════════════════════════════════════════
// قواعد أمان Firestore لمشروع أكليتو
//
// ⚠️ هالملف صار مُدار بالريبو من اليوم (11 أغسطس 2026) — قبل هيك كانت
// القواعد تُدار يدوياً من Firebase Console بدون تتبّع تاريخي بـ Git.
//
// الحالة الحالية: مسار "تفعيل Auth حقيقي" (مهمة 3+8 بـcontext.md) — قيد التنفيذ.
// drivers وcustomers وstores (+ store_employees) صارت مجموعات مقيّدة فعلياً
// بناءً على Firebase Anonymous Auth. باقي كل المجموعات لسا على وضعها المفتوح
// الأصلي (allow read, write: if true) بانتظار دورها.
//
// الدور القادم: orders (الأعقد — 3 أطراف: زبون/متجر/سائق).
// ══════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    /* هل صاحب الطلب أدمن؟ — بيتحقق من وجود مستند بمجموعة admins بنفس
       الـuid تبع حساب Firebase Auth (إيميل/باسورد) الخاص فيه.
       ⚠️ لازم مؤيد يعمل هالمستند يدوياً من Firebase Console أول مرة —
       تعليمات كاملة بـcontext.md. */
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /* تتحقق إنه صاحب الطلب Auth هو نفسه صاحب مستند العميل (customerId)، أو إنه
       المستند لسا قديم ما انربط بعد (نافذة انتقالية) — تُستخدم لمجموعات فرعية
       زي customers/{id}/addresses اللي ما فيها هي نفسها حقل auth_uid. */
    function isOwnerCustomer(customerId) {
      let cust = get(/databases/$(database)/documents/customers/$(customerId)).data;
      return request.auth != null && (
        cust.auth_uid == request.auth.uid ||
        !('auth_uid' in cust) ||
        cust.auth_uid == null
      );
    }

    /* مجموعة قائمة الأدمنز نفسها — قراءة بس لأي حد مسجّل دخول (عشان
       isAdmin() تقدر تتحقق)، وكتابة ممنوعة بالكامل من التطبيق (تُدار
       يدوياً من Firebase Console حالياً لحد ما نبني صفحة إدارة مخصصة). */
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    /* ═══ drivers — أول مجموعة مقيّدة فعلياً (تجربة) ═══
       - القراءة تضل عامة: مستخدمة لعرض "السائقين القريبين مني" بالخريطة
         ولوحة تحكم الأدمن، ما فيها بيانات حساسة كافية تستاهل تقييد القراءة حالياً.
       - الإنشاء (create): لازم يكون فيه Auth (حتى لو مجهول/Anonymous)،
         وحقل auth_uid بالمستند الجديد لازم يطابق هوية المُنشئ.
       - التعديل (update): مسموح للأدمن دايماً. غير هيك، مسموح بس لصاحب
         المستند (auth_uid يطابق)، أو لو المستند قديم وما فيه auth_uid
         بعد (سائقين سجّلوا قبل هالتحديث — أول تسجيل دخول إلهم بعد
         التحديث بيربط حسابهم تلقائياً — نافذة انتقالية مؤقتة، موثّقة
         بـcontext.md). بكل الحالات غير الأدمن: ممنوع السائق يحط
         approval_status = approved بنفسه (بس يقدر يرجعها pending —
         إعادة تقديم بعد رفض)، وممنوع يلمس is_active إطلاقاً (تفعيل/
         إيقاف الحساب قرار أدمن حصري).
       - الحذف: أدمن بس. */
    match /drivers/{driverId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.auth_uid == request.auth.uid;

      allow update: if isAdmin() || (
        request.auth != null &&
        (
          resource.data.auth_uid == request.auth.uid ||
          !('auth_uid' in resource.data) ||
          resource.data.auth_uid == null
        ) &&
        !(request.resource.data.approval_status == 'approved' && resource.data.approval_status != 'approved') &&
        request.resource.data.is_active == resource.data.is_active
      );

      allow delete: if isAdmin() || (
        request.auth != null && resource.data.auth_uid == request.auth.uid
      );
    }

    /* ═══ customers — ثاني مجموعة مقيّدة فعلياً (نفس نمط drivers) ═══
       - القراءة تضل عامة: تستخدمها لوحة الأدمن (قائمة الزبائن).
       - الإنشاء: لازم Auth (حتى Anonymous) + auth_uid يطابق هوية المُنشئ.
       - التعديل: مسموح للأدمن دايماً، أو لصاحب المستند (auth_uid يطابق،
         أو المستند قديم وبعده ما انربط — نافذة انتقالية). ممنوع الزبون
         يلمس is_blocked (حظر/إلغاء حظر الحساب قرار أدمن حصري من
         akleto-admin-customers.html).
       - الحذف: أدمن، أو الزبون نفسه (ميزة حذف الحساب موجودة أصلاً). */
    match /customers/{customerId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.auth_uid == request.auth.uid;

      allow update: if isAdmin() || (
        request.auth != null &&
        (
          resource.data.auth_uid == request.auth.uid ||
          !('auth_uid' in resource.data) ||
          resource.data.auth_uid == null
        ) &&
        request.resource.data.is_blocked == resource.data.is_blocked
      );

      allow delete: if isAdmin() || (
        request.auth != null && resource.data.auth_uid == request.auth.uid
      );
    }

    /* عناوين توصيل الزبون — مجموعة فرعية، لازم قاعدة منفصلة (Firestore ما
       بتورّث قواعد المستند الأب للمجموعات الفرعية تلقائياً). صاحب العنوان
       بس (أو الأدمن) يقدر يقرأ/يعدّل/يحذف. */
    match /customers/{customerId}/addresses/{addressId} {
      allow read, write: if isAdmin() || isOwnerCustomer(customerId);
    }

    /* ═══ stores — ثالث مجموعة مقيّدة فعلياً (نموذج مختلف عن drivers/customers) ═══
       خصوصية المتجر: أكتر من موظف ممكن يسجّلوا دخول لنفس المتجر بنفس رمز
       PIN (كل واحد من جهازه). فبدل ما نربط auth_uid واحد بالمستند، منجمع
       كل الأجهزة المصرّح لها بمصفوفة authorized_uids على مستند المتجر نفسه.
       - القراءة تضل عامة: تصفّح المتاجر من تطبيق الزبون + البحث بالـPIN
         وقت تسجيل الدخول (قبل ما يصير أي Auth مرتبط أصلاً بالمتجر).
       - الإنشاء: أدمن بس (المتاجر تُنشأ من لوحة التحكم حصراً، ما في تسجيل
         ذاتي للمتاجر الجديدة).
       - التعديل: الأدمن دايماً، أو أي موظف مصرّح له (uid موجود بـ
         authorized_uids)، أو لو المتجر قديم وما فيه authorized_uids بعد
         (نافذة انتقالية — ⚠️ أوسع شوي من درايفرز/كستمرز لأنه أي حد
         مسجّل Auth مجهول يقدر "يتبنى" متجر ما اتلمس بعد، بس التأثير
         العملي محدود لأنه المتجر أصلاً بدون هالخطوة ما بيقدر يسوي شي
         حساس — بس الدخول الفعلي للتطبيق نفسه محمي بالـPIN). ممنوع غير
         الأدمن يلمس is_active أو pin (قرارات أدمن حصراً).
       - الحذف: أدمن بس (لا يوجد حذف ذاتي من تطبيق المتجر). */
    match /stores/{storeId} {
      allow read: if true;

      allow create: if isAdmin();

      allow update: if isAdmin() || (
        request.auth != null &&
        (
          request.auth.uid in resource.data.authorized_uids ||
          !('authorized_uids' in resource.data) ||
          resource.data.authorized_uids.size() == 0
        ) &&
        request.resource.data.is_active == resource.data.is_active &&
        request.resource.data.pin == resource.data.pin
      );

      allow delete: if isAdmin();
    }

    /* موظفو المتاجر — سجل كل شخص سجّل دخول بمتجر معيّن (اسم/هاتف/متجر).
       القراءة عامة (تستخدمها لوحة الأدمن لعرض كل الموظفين + منطق تسجيل
       الدخول نفسه للتحقق من موظف موجود مسبقاً بغض النظر عن جهازه).
       الكتابة: تسجيل موظف جديد لازم Auth، والتعديل بس لصاحب السجل. */
    match /store_employees/{empId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if isAdmin() || (
        request.auth != null && (
          resource.data.auth_uid == request.auth.uid ||
          !('auth_uid' in resource.data) ||
          resource.data.auth_uid == null
        )
      );
      allow delete: if isAdmin();
    }

    /* ═══ باقي المجموعات — لسا على وضعها المفتوح الأصلي، بانتظار دورها
       بعد ما نتأكد إنه نمط drivers وcustomers وstores شغالين صح فعلياً. ═══ */
    match /orders/{id} { allow read, write: if true; }
    match /admin_notifications/{id} { allow read, write: if true; }
    match /user_notifications/{id} { allow read, write: if true; }
    match /app_settings/{id} { allow read, write: if true; }
    match /coupons/{id} { allow read, write: if true; }
    match /meals/{id} { allow read, write: if true; }
    match /meal_ingredients/{id} { allow read, write: if true; }
    match /ingredients/{id} { allow read, write: if true; }
    match /measure_config/{id} { allow read, write: if true; }
    match /counters/{id} { allow read, write: if true; }
    match /driver_shifts/{id} { allow read, write: if true; }
    match /driver_balance_transactions/{id} { allow read, write: if true; }
    match /store_employees/{id} { allow read, write: if true; }
    match /store_ingredients/{id} { allow read, write: if true; }
    match /store_work_sessions/{id} { allow read, write: if true; }
    match /store_commission_requests/{id} { allow read, write: if true; }
    match /users/{id} { allow read, write: if true; }
  }
}

rules_version = '2';

// ══════════════════════════════════════════════════════════
// قواعد أمان Firestore لمشروع أكليتو
//
// ⚠️ هالملف صار مُدار بالريبو من اليوم (11 أغسطس 2026) — قبل هيك كانت
// القواعد تُدار يدوياً من Firebase Console بدون تتبّع تاريخي بـ Git.
//
// الحالة الحالية: مسار "تفعيل Auth حقيقي" (مهمة 3+8 بـcontext.md) — المرحلة
// الأساسية اكتملت. drivers وcustomers وstores (+ store_employees) وorders
// صارت كلها مجموعات مقيّدة فعلياً بناءً على Firebase Anonymous Auth.
// باقي المجموعات (تشغيلية/مالية داخلية، بدون تعرّض مباشر من تطبيق طرف
// ثالث غير موثوق) لسا على وضعها المفتوح الأصلي (allow read, write: if true).
//
// 🐛 تم إصلاح باغ بنفس هالتحديث: store_employees كانت معرّفة مرتين (قاعدة
// مقيّدة + قاعدة مفتوحة بالأسفل) — بما إنه Firestore بتطبّق OR بين كل
// match تطابق نفس المسار، القاعدة المفتوحة كانت عملياً تُلغي القيود.
// ══════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    /* هل صاحب الطلب أدمن؟ — بيتحقق من وجود مستند بمجموعة admins بنفس
       الـuid تبع حساب Firebase Auth (إيميل/باسورد) الخاص فيه.
       ⚠️ لازم مؤيد يعمل هالمستند يدوياً من Firebase Console أول مرة —
       تعليمات كاملة بـcontext.md. */
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /* تتحقق إنه صاحب الطلب Auth هو نفسه صاحب مستند العميل (customerId)، أو إنه
       المستند لسا قديم ما انربط بعد (نافذة انتقالية) — تُستخدم لمجموعات فرعية
       زي customers/{id}/addresses اللي ما فيها هي نفسها حقل auth_uid. */
    function isOwnerCustomer(customerId) {
      let cust = get(/databases/$(database)/documents/customers/$(customerId)).data;
      return request.auth != null && (
        cust.auth_uid == request.auth.uid ||
        !('auth_uid' in cust) ||
        cust.auth_uid == null
      );
    }

    /* تتحقق إنه صاحب الطلب Auth هو نفسه صاحب مستند السائق (driverId)، أو إنه
       المستند لسا قديم ما انربط بعد (نافذة انتقالية) — تُستخدم لتأمين تحديثات
       orders من طرف السائق (الاستلام، مراحل التوصيل، التقييم). */
    function isOwnerDriver(driverId) {
      return driverId != null &&
        exists(/databases/$(database)/documents/drivers/$(driverId)) &&
        request.auth != null && (
          get(/databases/$(database)/documents/drivers/$(driverId)).data.auth_uid == request.auth.uid ||
          !('auth_uid' in get(/databases/$(database)/documents/drivers/$(driverId)).data) ||
          get(/databases/$(database)/documents/drivers/$(driverId)).data.auth_uid == null
        );
    }

    /* تتحقق إنه صاحب الطلب Auth موظف مصرّح له بنفس المتجر (storeId) —
       نفس منطق authorized_uids المستخدم بمجموعة stores. */
    function isStoreEmployee(storeId) {
      let store = get(/databases/$(database)/documents/stores/$(storeId)).data;
      return storeId != null &&
        exists(/databases/$(database)/documents/stores/$(storeId)) &&
        request.auth != null && (
          request.auth.uid in store.authorized_uids ||
          !('authorized_uids' in store) ||
          store.authorized_uids.size() == 0
        );
    }

    /* مجموعة قائمة الأدمنز نفسها — قراءة بس لأي حد مسجّل دخول (عشان
       isAdmin() تقدر تتحقق)، وكتابة ممنوعة بالكامل من التطبيق (تُدار
       يدوياً من Firebase Console حالياً لحد ما نبني صفحة إدارة مخصصة). */
    match /admins/{adminId} {
      allow read: if request.auth != null;
      /* استثناء وحيد: الأدمن يقدر يحدّث مستنده الخاص هو بس (مثلاً حفظ
         fcm_token لإشعارات الدفع) — إنشاء/حذف حساب أدمن جديد يضل ممنوع
         بالكامل من التطبيق (يُدار يدوياً من Firebase Console). */
      allow update: if request.auth != null && request.auth.uid == adminId;
      allow create, delete: if false;
    }

    /* ═══ drivers — أول مجموعة مقيّدة فعلياً (تجربة) ═══
       - القراءة تضل عامة: مستخدمة لعرض "السائقين القريبين مني" بالخريطة
         ولوحة تحكم الأدمن، ما فيها بيانات حساسة كافية تستاهل تقييد القراءة حالياً.
       - الإنشاء (create): لازم يكون فيه Auth (حتى لو مجهول/Anonymous)،
         وحقل auth_uid بالمستند الجديد لازم يطابق هوية المُنشئ.
       - التعديل (update): مسموح للأدمن دايماً. غير هيك، مسموح بس لصاحب
         المستند (auth_uid يطابق)، أو لو المستند قديم وما فيه auth_uid
         بعد (سائقين سجّلوا قبل هالتحديث — أول تسجيل دخول إلهم بعد
         التحديث بيربط حسابهم تلقائياً — نافذة انتقالية مؤقتة، موثّقة
         بـcontext.md). بكل الحالات غير الأدمن: ممنوع السائق يحط
         approval_status = approved بنفسه (بس يقدر يرجعها pending —
         إعادة تقديم بعد رفض)، وممنوع يلمس is_active إطلاقاً (تفعيل/
         إيقاف الحساب قرار أدمن حصري).
       - الحذف: أدمن بس. */
    match /drivers/{driverId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.auth_uid == request.auth.uid;

      allow update: if isAdmin() || (
        request.auth != null &&
        (
          resource.data.auth_uid == request.auth.uid ||
          !('auth_uid' in resource.data) ||
          resource.data.auth_uid == null
        ) &&
        !(request.resource.data.approval_status == 'approved' && resource.data.approval_status != 'approved') &&
        request.resource.data.is_active == resource.data.is_active
      );

      allow delete: if isAdmin() || (
        request.auth != null && resource.data.auth_uid == request.auth.uid
      );
    }

    /* ═══ customers — ثاني مجموعة مقيّدة فعلياً (نفس نمط drivers) ═══
       🚨 القراءة كانت `if true` (لازمة نظرياً لفحص "هل الرقم مسجّل
       مسبقاً" قبل أي Auth بشاشتي التسجيل/الدخول) — بس هذا كان يسمح لأي
       حد بالعالم يفرّغ اسم ورقم هاتف كل زبون بالنظام بلا فلتر (تسريب
       بيانات حقيقي، ثغرة مشابهة لثغرة PIN المتجر بس بدون خطر انتحال
       هوية مباشر). الحل: القراءة صارت مقيّدة لصاحب الحساب/الأدمن بس،
       وفحص الرقم قبل الـOTP صار حصراً عبر Cloud Function
       (checkCustomerPhone) بترجّع معلومة رقم واحد بس تم إرساله، مو
       كامل الجدول.
       - الإنشاء: لازم Auth (حتى Anonymous) + auth_uid يطابق هوية المُنشئ.
       - التعديل: مسموح للأدمن دايماً، أو لصاحب المستند (auth_uid يطابق،
         أو المستند قديم وبعده ما انربط — نافذة انتقالية). ممنوع الزبون
         يلمس is_blocked (حظر/إلغاء حظر الحساب قرار أدمن حصري من
         akleto-admin-customers.html).
       - الحذف: أدمن، أو الزبون نفسه (ميزة حذف الحساب موجودة أصلاً). */
    match /customers/{customerId} {
      allow read: if isAdmin() || isOwnerCustomer(customerId);

      allow create: if request.auth != null
        && request.resource.data.auth_uid == request.auth.uid;

      allow update: if isAdmin() || (
        request.auth != null &&
        (
          resource.data.auth_uid == request.auth.uid ||
          !('auth_uid' in resource.data) ||
          resource.data.auth_uid == null
        ) &&
        request.resource.data.is_blocked == resource.data.is_blocked
      );

      allow delete: if isAdmin() || (
        request.auth != null && resource.data.auth_uid == request.auth.uid
      );
    }

    /* عناوين توصيل الزبون — مجموعة فرعية، لازم قاعدة منفصلة (Firestore ما
       بتورّث قواعد المستند الأب للمجموعات الفرعية تلقائياً). صاحب العنوان
       بس (أو الأدمن) يقدر يقرأ/يعدّل/يحذف. */
    match /customers/{customerId}/addresses/{addressId} {
      allow read, write: if isAdmin() || isOwnerCustomer(customerId);
    }

    /* ═══ stores — ثالث مجموعة مقيّدة فعلياً (نموذج مختلف عن drivers/customers) ═══
       خصوصية المتجر: أكتر من موظف ممكن يسجّلوا دخول لنفس المتجر بنفس رمز
       PIN (كل واحد من جهازه). فبدل ما نربط auth_uid واحد بالمستند، منجمع
       كل الأجهزة المصرّح لها بمصفوفة authorized_uids على مستند المتجر نفسه.
       - القراءة تضل عامة: تصفّح المتاجر من تطبيق الزبون + البحث بالـPIN
         وقت تسجيل الدخول (قبل ما يصير أي Auth مرتبط أصلاً بالمتجر).
       - الإنشاء: أدمن بس (المتاجر تُنشأ من لوحة التحكم حصراً، ما في تسجيل
         ذاتي للمتاجر الجديدة).
       - التعديل: الأدمن دايماً، أو أي موظف مصرّح له (uid موجود بـ
         authorized_uids)، أو لو المتجر قديم وما فيه authorized_uids بعد
         (نافذة انتقالية — ⚠️ أوسع شوي من درايفرز/كستمرز لأنه أي حد
         مسجّل Auth مجهول يقدر "يتبنى" متجر ما اتلمس بعد، بس التأثير
         العملي محدود لأنه المتجر أصلاً بدون هالخطوة ما بيقدر يسوي شي
         حساس — بس الدخول الفعلي للتطبيق نفسه محمي بالـPIN). ممنوع غير
         الأدمن يلمس is_active أو pin (قرارات أدمن حصراً).
       - الحذف: أدمن بس (لا يوجد حذف ذاتي من تطبيق المتجر). */
    match /stores/{storeId} {
      allow read: if true;

      allow create: if isAdmin();

      allow update: if isAdmin() || (
        request.auth != null &&
        (
          request.auth.uid in resource.data.authorized_uids ||
          !('authorized_uids' in resource.data) ||
          resource.data.authorized_uids.size() == 0
        ) &&
        request.resource.data.is_active == resource.data.is_active
      );

      allow delete: if isAdmin();
    }

    /* موظفو المتاجر — سجل الأشخاص المصرّح لهم بالدخول لمتجر معيّن.
       🆕 نظام PIN اتلغى بالكامل (كان فيه احتمال تخمين + إمكانية "تسجيل
       موظف جديد" وهمي بمجرد تخمين رقم صحيح). الأدمن هلق هو يلي بيضيف
       رقم هاتف كل موظف مسبقاً (create: isAdmin بس) — الموظف نفسه بس
       بيقدر "يفعّل" سجله (يربط auth_uid) أول مرة بيسجّل دخول بالـOTP،
       مش يخلق سجل جديد من الصفر.
       القراءة عامة: يستخدمها منطق تسجيل الدخول نفسه (تطبيق المتجر) للتحقق
       قبل حتى ما يبعت OTP إنه الرقم مصرّح لهذا المتجر بالذات، وتستخدمها
       لوحة الأدمن لعرض/إدارة القوائم. */
    match /store_employees/{empId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null && (
          resource.data.auth_uid == request.auth.uid ||
          !('auth_uid' in resource.data) ||
          resource.data.auth_uid == null
        )
      );
      allow delete: if isAdmin();
    }

    /* ═══ orders — رابعة وآخر مجموعة بمهمة 3+8 (الأعقد: 3 أطراف) ═══
       - القراءة تضل عامة: يستخدمها الزبون (طلباته)، المتجر (طلباته)،
         السائق (تصفّح المتاح + طلباته)، ولوحة الأدمن (كل الطلبات) —
         نفس نمط باقي المجموعات، تقييد القراءة لكل طرف لحاله معقّد
         (يحتاج فلترة على مستوى الاستعلام نفسه مش بس القاعدة) ومو
         أولوية حالياً بما إنه لا بيانات دفع حساسة (بطاقات) مخزّنة هون.
       - الإنشاء: حصراً من تطبيق الزبون — لازم Auth + customer_id
         بالمستند الجديد يطابق حساب الزبون المسجّل دخول (isOwnerCustomer).
       - التعديل: 4 مسارات مسموحة (OR بينهم):
         1) الأدمن: أي تعديل بأي وقت (لوحة akleto-admin-orders.html).
         2) المتجر: بس لو storeId بالطلب يطابق متجره (موظف مصرّح له)،
            وممنوع يغيّر customer_id/store_id/driver_id/السعر الإجمالي —
            يعني يقدر يحدّث الحالة لـready + حقول loaded_by/ready_at بس.
         3) سائق يستلم طلب جاهز (ready→delivering): لازم driver_id
            الجديد يطابق حسابه هو (isOwnerDriver)، وممنوع يغيّر
            customer_id/store_id/السعر.
         4) سائق أصلاً مستلم الطلب (driver_id موجود ويطابقه): يقدر
            يكمل مراحل التوصيل (driver_flow_stage، status→done،
            driver_rating...) بس ممنوع يغيّر customer_id/store_id/
            driver_id/السعر بعد الاستلام.
         ⚠️ ملاحظة: Cloud Functions (onOrderReady, onOrderUpdated...)
         بتستخدم Admin SDK اللي أصلاً بيتجاوز كل قواعد الأمان هاي —
         مو محتاجة استثناء صريح هون.
       - الحذف: أدمن بس (لا يوجد حذف طلبات من أي تطبيق حالياً). */
    match /orders/{orderId} {
      allow read: if true;

      allow create: if request.auth != null
        && 'customer_id' in request.resource.data
        && isOwnerCustomer(request.resource.data.customer_id);

      allow update: if isAdmin() || (
        request.auth != null &&
        resource.data.store_id != null &&
        isStoreEmployee(resource.data.store_id) &&
        request.resource.data.customer_id == resource.data.customer_id &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.driver_id == resource.data.driver_id &&
        request.resource.data.total_estimated_price == resource.data.total_estimated_price
      ) || (
        request.auth != null &&
        resource.data.status == 'ready' &&
        request.resource.data.status == 'delivering' &&
        isOwnerDriver(request.resource.data.driver_id) &&
        request.resource.data.customer_id == resource.data.customer_id &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.total_estimated_price == resource.data.total_estimated_price
      ) || (
        request.auth != null &&
        resource.data.driver_id != null &&
        isOwnerDriver(resource.data.driver_id) &&
        request.resource.data.driver_id == resource.data.driver_id &&
        request.resource.data.customer_id == resource.data.customer_id &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.total_estimated_price == resource.data.total_estimated_price
      );

      allow delete: if isAdmin();
    }

    /* ═══ باقي المجموعات — لسا على وضعها المفتوح الأصلي (بانتظار دور
       لاحق لو احتجنا)، عدا store_employees اللي اتصحّح تكرارها هون. ═══ */
    match /admin_notifications/{id} { allow read, write: if true; }
    match /user_notifications/{id} { allow read, write: if true; }
    match /app_settings/{id} { allow read, write: if true; }
    match /coupons/{id} { allow read, write: if true; }
    match /meals/{id} { allow read, write: if true; }
    match /meal_ingredients/{id} { allow read, write: if true; }
    match /ingredients/{id} { allow read, write: if true; }
    match /measure_config/{id} { allow read, write: if true; }
    match /counters/{id} { allow read, write: if true; }
    match /driver_shifts/{id} { allow read, write: if true; }
    match /driver_balance_transactions/{id} { allow read, write: if true; }
    match /store_ingredients/{id} { allow read, write: if true; }
    match /store_work_sessions/{id} { allow read, write: if true; }
    match /store_commission_requests/{id} { allow read, write: if true; }
    match /users/{id} { allow read, write: if true; }
  }
}

